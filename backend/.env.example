# Copy to .env and fill in. Never commit .env.
PORT=1989
MONGODB=
MYACCESSKEY=
MYREFRESHKEY=
NODE_ENV=development
# Frontend URL(s) allowed to call the API, comma-separated.
# Defaults to http://localhost:5173 when unset.
CLIENT_ORIGIN=
# Sign-in cookie SameSite: strict | lax | none. Defaults to "none" in
# production (frontend and API on different sites) and "strict" otherwise.
# Use "strict" once both run on your own domain (example.com + api.example.com).
COOKIE_SAMESITE=

# Live Sessions (WebRTC). Max people per session (default 6).
ROOM_MAX_PEERS=
# How long (ms) a dropped connection gets to come back before the call
# ends (default 15000 = 15 seconds). Clicking Leave ends it at once.
SESSION_END_GRACE_MS=
# Optional TURN relay for users behind strict firewalls. TURN_URL can be
# comma-separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: password for the sample members added by `npm run seed:members`,
# so you can sign in as one (e.g. to accept a friend request). Dev only.
DEMO_PASSWORD=
